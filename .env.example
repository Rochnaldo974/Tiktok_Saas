# Copiez ce fichier vers .env.local et remplissez les valeurs.

# Supabase — obligatoire (auth, préférences, bibliothèque, planning).
# Clé publishable : publique par conception, la sécurité repose sur les policies RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# API Claude — scripts IA et analyse de profil.
# Optionnel : sans clé, l'app répond un 503 explicite sur ces features.
ANTHROPIC_API_KEY=

# Données TikTok réelles : AUCUNE clé requise — la source primaire est
# gratuite (tikwm.com, ~1 req/s, sérialisée + cache serveur 45 min).
# Optionnel : token EnsembleData (ensembledata.com) appelé en secours
# uniquement si la source gratuite ne renvoie rien.
ENSEMBLEDATA_TOKEN=

# Forcer le mode démo (tendances simulées, zéro appel externe) :
# SIGNAL_DEMO_DATA=1
